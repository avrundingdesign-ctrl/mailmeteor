# Kopiere diese Datei nach .env und trage deine Daten ein.
# .env ist per .gitignore ausgeschlossen und gehört nie ins Repository.

# --- Zugangsdaten ---------------------------------------------------------
# Gmail: SMTP_USER ist deine Adresse, SMTP_PASS ein App-Passwort
# (Google-Konto → Sicherheit → 2-Faktor → App-Passwörter).
# Das normale Kontopasswort funktioniert bei Gmail nicht.
SMTP_USER=deine.adresse@gmail.com
SMTP_PASS=abcd efgh ijkl mnop

# --- Server --------------------------------------------------------------
# Für gmail.com, outlook.com, web.de, gmx.de wird das automatisch gesetzt.
# Bei eigener Domain / anderem Anbieter hier eintragen:
# SMTP_HOST=smtp.deinanbieter.de
# SMTP_PORT=587
# SMTP_SECURE=false      # true bei Port 465

# --- Absender ------------------------------------------------------------
# Anzeigename im Postfach der Empfänger. Standard: SMTP_USER.
MAIL_FROM=Max Mustermann <deine.adresse@gmail.com>
# MAIL_REPLY_TO=antwort@example.com

# --- Antworten abrufen und durchsuchen -----------------------------------
# Für den Abruf werden dieselben Zugangsdaten wie oben benutzt (bei Gmail also
# dasselbe App-Passwort). Der IMAP-Server wird für gmail, outlook, web.de und
# gmx automatisch gesetzt; bei eigener Domain hier eintragen:
# IMAP_HOST=imap.deinanbieter.de
# IMAP_PORT=993

# Schlüssel für die KI-Suche in den Antworten (console.anthropic.com).
# Ohne Schlüssel funktioniert alles andere weiter, nur die Suche nicht.
# ANTHROPIC_API_KEY=sk-ant-...
